# Copy to server/.env and fill in. This file is the only place a provider key
# should ever appear: .env is gitignored, and the browser never sees it.

# --- the real credential, held here and nowhere else -----------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- what the browser presents ---------------------------------------------
# Comma-separated. Cheap on purpose: it authorises spending only through this
# server, under the ceilings below, so a leak costs you one line of this file
# rather than a provider credential. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEYS=change-me-then-paste-into-settings

# --- who may call ----------------------------------------------------------
# Leave empty to allow any origin. Set it in production.
ALLOWED_ORIGINS=https://antoine311200.github.io,http://localhost:3000

# --- ceilings, so a leaked app key cannot run up a bill --------------------
RATE_PER_MINUTE=12
MAX_TOKENS=4000
DAILY_TOKEN_BUDGET=300000
# ALLOWED_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001

# --- optional --------------------------------------------------------------
PORT=8787
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_URL=https://api.anthropic.com/v1/messages
